# Debug profile: same build as bench + strace wrapper (syscall profiling runs).
FROM rustle:bench
USER root
RUN apt-get update && apt-get install -y --no-install-recommends strace && \
    rm -rf /var/lib/apt/lists/*
ENV TRACE_PATH=/tmp/syscall.trace
ENTRYPOINT ["sh", "-c", "exec strace -f -qq -e trace=network,epoll_wait,epoll_ctl,epoll_pwait,read,write,writev,close,splice,futex -o ${TRACE_PATH} rustle /etc/rustle/${AUTH:-on}.toml"]
