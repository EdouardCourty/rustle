  "limits": [
    {
      "id": "workload",
      "text": "The origin is static with Content-Length. Chunked bodies, uploads, SOCKS5, IPv6, many origins and large header sets are not part of the matrix; they are covered functionally by the end-to-end suite."
    },
    {
      "id": "one-campaign",
      "text": "One campaign, one seed, three repeats, medians, noise about ±3 to 5 %, no confidence intervals. Differences below the noise are not conclusions."
    },
    {
      "id": "closed-loop",
      "text": "Latency is closed-loop at each concurrency level (no open-loop rate); CPU per request is measured at saturation, not at an equal offered load."
    },
    {
      "id": "link-bound",
      "text": "The 25 Gbit/s link (23.5 measured) is a ceiling: a proxy that reaches it (rustle at 1 MB, 10 MB and in plain tunnels) shows the link, not its own limit, and its figure is a lower bound."
    },
    {
      "id": "tls-no-splice",
      "text": "There is no splice on a TLS port (the proxy decrypts in user space), so TLS and HTTP/2 throughput is lower than plain HTTP."
    },
    {
      "id": "h2-sequential",
      "text": "The HTTP/2 test opens one connection per client connection and sends sequential requests (no multiplexing)."
    },
    {
      "id": "multi-core",
      "text": "Multi-core was measured for plain HTTP at 1 KB only; TLS, HTTP/2 and tunnels were not measured on several cores."
    },
    {
      "id": "cpu-attribution",
      "text": "Proxy CPU is the container cgroup's (user + system); softirq time spent on other cores is not attributed."
    },
    {
      "id": "flood-upload",
      "text": "The tunnel test counts bytes written by the client and measures the upload direction only."
    }
  ]
}
