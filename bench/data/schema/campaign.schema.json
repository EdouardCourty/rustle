{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EdouardCourty/rustle/main/bench/data/schema/campaign.schema.json",
  "title": "rustle benchmark campaign",
  "description": "A published measurement campaign: its conditions, which runs make it up, its caveats. Hand-edited; the seed, repeats, proxy cores and auth are checked against the runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "date",
    "rustle_version",
    "commit",
    "hardware",
    "network",
    "software",
    "seed",
    "repeats",
    "run_seconds",
    "proxy_cores",
    "auth",
    "noise_pct",
    "protocol",
    "fairness",
    "results",
    "sources",
    "limits",
    "test_notes"
  ],
  "properties": {
    "$schema": {
      "title": "Schema pointer",
      "description": "Relative path to this schema, for editors.",
      "const": "../schema/campaign.schema.json"
    },
    "schema_version": {
      "title": "Schema version",
      "description": "Version of this contract. A breaking change bumps it; readers must refuse a version they do not know.",
      "const": 1
    },
    "id": {
      "title": "Campaign id",
      "description": "Id of the campaign: its folder name under bench/data/ and bench/published/.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(-[a-z0-9]+)*$"
    },
    "date": {
      "title": "Date",
      "description": "Day of the campaign (YYYY-MM-DD).",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rustle_version": {
      "title": "rustle version",
      "description": "Version of rustle that was benchmarked.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "commit": {
      "title": "Commit",
      "description": "Commit of rustle that was benchmarked.",
      "type": "string"
    },
    "hardware": {
      "title": "Hardware",
      "description": "The three servers.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "generator",
        "proxy",
        "origin_sink"
      ],
      "properties": {
        "provider": {
          "title": "Provider",
          "description": "Where the servers are.",
          "type": "string"
        },
        "generator": {
          "$ref": "#/$defs/machine",
          "title": "Generator",
          "description": "Runs the load generator."
        },
        "proxy": {
          "$ref": "#/$defs/machine",
          "title": "Proxy",
          "description": "Runs the proxy under test."
        },
        "origin_sink": {
          "$ref": "#/$defs/machine",
          "title": "Origin and sink",
          "description": "Runs the static origin and the discard sink."
        }
      }
    },
    "network": {
      "title": "Network",
      "description": "The link between the servers.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mtu",
        "nominal_gbit_s",
        "measured_gbit_s",
        "measured_with"
      ],
      "properties": {
        "kind": {
          "title": "Kind",
          "description": "Type of network.",
          "type": "string"
        },
        "mtu": {
          "title": "MTU",
          "description": "Maximum transmission unit in bytes.",
          "type": "integer",
          "minimum": 1
        },
        "nominal_gbit_s": {
          "title": "Nominal speed",
          "description": "Nominal link speed in Gbit/s.",
          "type": "number"
        },
        "measured_gbit_s": {
          "title": "Measured speed",
          "description": "Measured link speed in Gbit/s.",
          "type": "number"
        },
        "measured_with": {
          "title": "Measured with",
          "description": "Tool used to measure the link.",
          "type": "string"
        }
      }
    },
    "software": {
      "title": "Software",
      "description": "System software of the servers.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "kernel",
        "docker",
        "governor"
      ],
      "properties": {
        "os": {
          "title": "OS",
          "description": "Operating system.",
          "type": "string"
        },
        "kernel": {
          "title": "Kernel",
          "description": "Kernel version.",
          "type": "string"
        },
        "docker": {
          "title": "Docker",
          "description": "Docker version.",
          "type": "string"
        },
        "governor": {
          "title": "CPU governor",
          "description": "CPU frequency governor.",
          "type": "string"
        }
      }
    },
    "seed": {
      "title": "Seed",
      "description": "Seed of the shuffled test order (checked against the runs).",
      "type": "integer"
    },
    "repeats": {
      "title": "Repeats",
      "description": "Measured runs per point; the median is kept (checked against the runs).",
      "type": "integer",
      "minimum": 1
    },
    "run_seconds": {
      "title": "Run length",
      "description": "Duration of a measured run in seconds.",
      "type": "integer",
      "minimum": 1
    },
    "proxy_cores": {
      "title": "Proxy cores",
      "description": "Cores (and workers) given to every proxy in the main matrix (checked against the runs).",
      "type": "integer",
      "minimum": 1
    },
    "auth": {
      "title": "Authentication",
      "description": "Whether authentication was on (checked against the runs).",
      "type": "boolean"
    },
    "noise_pct": {
      "title": "Noise",
      "description": "Run-to-run noise range in percent: differences below it are not conclusions.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "title": "Lower bound",
          "description": "Lower bound in percent.",
          "type": "number"
        },
        "max": {
          "title": "Upper bound",
          "description": "Upper bound in percent.",
          "type": "number"
        }
      }
    },
    "protocol": {
      "title": "Protocol",
      "description": "The measurement protocol in one sentence.",
      "type": "string",
      "minLength": 1
    },
    "fairness": {
      "title": "Fairness document",
      "description": "Path of the document that records each competitor's version and tuning.",
      "type": "string"
    },
    "results": {
      "title": "Results document",
      "description": "Path of the document with the full tables.",
      "type": "string"
    },
    "sources": {
      "title": "Sources",
      "description": "The campaign indexes the numbers are computed from, relative to bench/ (normally the committed copy under published/).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main"
      ],
      "properties": {
        "main": {
          "title": "Main index",
          "description": "Plain, TLS, TLS full handshake and HTTP/2 matrices.",
          "type": "string"
        },
        "ws": {
          "title": "WebSocket index",
          "description": "WebSocket matrix, plain and TLS.",
          "type": "string"
        },
        "ktls": {
          "title": "kTLS index",
          "description": "rustle with tls.ktls = true.",
          "type": "string"
        },
        "scaling": {
          "title": "Scaling indexes",
          "description": "One index per core count of the multi-core curve.",
          "type": "array",
          "items": {
            "title": "Scaling index",
            "description": "The index of one core count.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cores",
              "index"
            ],
            "properties": {
              "cores": {
                "title": "Cores",
                "description": "Cores given to the proxy.",
                "type": "integer",
                "minimum": 1
              },
              "index": {
                "title": "Index",
                "description": "Path of the index.",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "unsupported": {
      "title": "Unsupported",
      "description": "Proxies that cannot do a transport at all (listed as unsupported, never as zero).",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "plain": {
          "$ref": "#/$defs/proxyList",
          "title": "plain",
          "description": "Proxies that cannot do the plain tests."
        },
        "tls": {
          "$ref": "#/$defs/proxyList",
          "title": "tls",
          "description": "Proxies that cannot do the tls tests."
        },
        "tls-full-handshake": {
          "$ref": "#/$defs/proxyList",
          "title": "tls-full-handshake",
          "description": "Proxies that cannot do the tls-full-handshake tests."
        },
        "h2": {
          "$ref": "#/$defs/proxyList",
          "title": "h2",
          "description": "Proxies that cannot do the h2 tests."
        },
        "ws": {
          "$ref": "#/$defs/proxyList",
          "title": "ws",
          "description": "Proxies that cannot do the ws tests."
        },
        "ws-tls": {
          "$ref": "#/$defs/proxyList",
          "title": "ws-tls",
          "description": "Proxies that cannot do the ws-tls tests."
        }
      }
    },
    "limits": {
      "title": "Limits",
      "description": "What the benchmark does not cover, to print next to the numbers.",
      "type": "array",
      "items": {
        "title": "Limit",
        "description": "One caveat of the benchmark.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "title": "Id",
            "description": "Stable identifier.",
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "text": {
            "title": "Text",
            "description": "The caveat, as a sentence.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "test_notes": {
      "title": "Test notes",
      "description": "Editorial reading of a point, by test id of benchmarks.json (for instance the link ceiling). Open by design: the keys are test ids.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "machine": {
      "title": "Machine",
      "description": "One server of the benchmark setup.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server",
        "cpu",
        "cores",
        "threads",
        "role"
      ],
      "properties": {
        "server": {
          "title": "Server",
          "description": "Server model.",
          "type": "string"
        },
        "cpu": {
          "title": "CPU",
          "description": "Processor model.",
          "type": "string"
        },
        "cores": {
          "title": "Cores",
          "description": "Physical cores.",
          "type": "integer",
          "minimum": 1
        },
        "threads": {
          "title": "Threads",
          "description": "Hardware threads.",
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "title": "Role",
          "description": "What runs on it.",
          "type": "string"
        }
      }
    },
    "proxyList": {
      "title": "Proxy list",
      "description": "A list of proxy ids.",
      "type": "array",
      "items": {
        "title": "Proxy id",
        "description": "Identifier of a compared proxy. A new proxy is added here: an additive change.",
        "enum": [
          "rustle",
          "3proxy",
          "squid",
          "gost",
          "tinyproxy"
        ]
      }
    }
  }
}
