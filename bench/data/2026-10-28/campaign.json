  "limits": [
    {
      "id": "workload",
      "text": "The origin is static with Content-Length. Chunked bodies, uploads, SOCKS5, IPv6, many origins and large header sets are not part of the matrix; they are covered functionally by the end-to-end suite."
    },
    {
      "id": "one-campaign",
      "text": "One campaign, one seed, three repeats, medians, noise about ±3 to 5 %, no confidence intervals. Differences below the noise are not conclusions."
    },
    {
      "id": "closed-loop",
      "text": "Latency is closed-loop at each concurrency level (no open-loop rate); CPU per request is measured with the proxy fully loaded, not at the same request rate for every proxy."
    },
    {
      "id": "link-bound",
      "text": "The test network can carry about 23.5 Gbit/s (25 nominal). Where rustle gets close to it (1 MB and 10 MB responses, plain tunnels), the network sets the number, not rustle: rustle's real figure, and its real lead, are higher than the one shown."
    },
    {
      "id": "tls-no-splice",
      "text": "There is no splice on a TLS port (the proxy decrypts in user space), so TLS and HTTP/2 throughput is lower than plain HTTP."
    },
    {
      "id": "h2-sequential",
      "text": "The HTTP/2 test opens one connection per client connection and sends sequential requests (no multiplexing)."
    },
    {
      "id": "multi-core",
      "text": "Multi-core was measured for plain HTTP at 1 KB only; TLS, HTTP/2 and tunnels were not measured on several cores."
    },
    {
      "id": "cpu-attribution",
      "text": "Proxy CPU is the container cgroup's (user + system); softirq time spent on other cores is not attributed."
    },
    {
      "id": "flood-upload",
      "text": "The tunnel test counts bytes written by the client and measures the upload direction only."
    }
  ],
  "test_notes": {
    "plain-1mb": "rustle uses 95 % of its core and gets about 22 of the 23.5 Gbit/s the test network can carry: the network starts to limit it here, so its real lead is somewhat higher than shown.",
    "plain-10mb": "rustle uses 83 % of its core and gets about 22 of the 23.5 Gbit/s the test network can carry: the network is the limit here, so rustle can go faster.",
    "plain-flood": "rustle uses 70 % of its core and gets about 22 of the 23.5 Gbit/s the test network can carry: the network is the limit here, so rustle can go faster.",
    "tls-short-full": "Session resumption is off: every connection is a full handshake with the certificate signature.",
    "ws-short": "Tinyproxy removes the Upgrade header (answered 426): it does not support WebSocket and is listed as unsupported, not as zero."
  }
