[server]
listen = "0.0.0.0:8080"
# Shards: each is one thread with its own runtime, SO_REUSEPORT listener
# and upstream pool (the kernel spreads connections). 0 = one per CPU.
# Pool limits below apply per shard.
workers = 1
# Pin shard i to the i-th CPU allowed to the process (cpuset-aware).
pin_cores = false
# Admin/health listener (GET /health -> 200, no auth). Bind 127.0.0.1 on
# a public VPS. Empty string disables it.
admin_listen = "127.0.0.1:8181"

[auth]
# API keys accepted as Basic auth passwords: Proxy-Authorization: Basic <base64(user:key)>.
# Leave empty to disable authentication entirely.
api_keys = [
    "secret1",
    "secret2",
]
# Client IPs/networks allowed to connect at all (CIDR), on every listener
# (HTTP, HTTPS/h2, SOCKS5); others are closed before any byte is read.
# Empty = everyone. Personal proxy behind a VPN, e.g. Tailscale:
# allow_clients = ["100.64.0.0/10", "fd7a:115c:a1e0::/48"]
allow_clients = []
# Wrong keys tolerated per client IP within failure_window, then the IP is
# banned for ban_duration (connections closed at accept). 0 disables.
# Requests without credentials (the browser's first 407) never count.
max_failures = 5
failure_window = "1m"
ban_duration = "15m"

[limits]
max_connections = 10000
max_header_bytes = 65536

[timeouts]
connect = "5s"
idle = "60s"
# Total time to receive a request head (from its first byte) or a SOCKS5
# handshake: a client trickling bytes (slowloris) cannot hold a slot.
request_head = "10s"

[dns]
# TTL of positive cache entries (0s disables). All resolved addresses are
# kept and tried in order. Wiped when max_entries is exceeded.
ttl = "60s"
max_entries = 4096

[http]
# Reuse idle upstream connections across requests (LIFO pool; one retry on
# a connection that died while idle). Disable to open/close an upstream
# connection per request.
upstream_keepalive = true
max_idle_per_origin = 256
# Body size limits in bytes (0 = unlimited). Requests over the limit are
# answered 413 before the body is sent; responses over the limit get 502
# (declared) or a truncated stream + close (unknown length).
max_request_body_bytes = 0
max_response_body_bytes = 0

[tls]
# HTTPS proxy listener (TLS between client and proxy), next to the plain
# one; empty disables it. Browsers use it via PAC "HTTPS host:port";
# curl via --proxy https://host:port (add --proxy-http2 for HTTP/2).
listen = ""
cert = "/etc/myproxy/cert.pem"
key = "/etc/myproxy/key.pem"
handshake_timeout = "10s"
# Offer HTTP/2 through ALPN (CONNECT and plain requests as h2 streams).
http2 = true
# Kernel TLS: after the rustls handshake, the session keys go to the kernel
# (module `tls`, probed at startup; userspace TLS otherwise). Measured: CONNECT
# tunnels +13 % throughput and -30 % memory at 25k tunnels, but HTTP bulk
# -37 % (1 MB) and +15 % CPU per new connection. Worth it for a mostly-HTTPS
# (CONNECT) workload with many tunnels.
ktls = false

[filter]
# Refuse non-public destinations: loopback, private networks, link-local
# (incl. cloud metadata 169.254.169.254), CGNAT, multicast, reserved, IPv6
# ULA/link-local. Checked on the resolved address (a public name pointing
# at a private IP is refused too). Set false to reach your LAN.
block_private = true
# Extra refused networks.
deny = []
# Allowed destination ports for CONNECT, HTTP and SOCKS5 (empty = all).
# allowed_ports = [80, 443]
allowed_ports = []

[socks5]
# SOCKS5 listener: CONNECT and UDP ASSOCIATE (QUIC/HTTP3, DNS through
# SOCKS). Password = one of the api_keys, username ignored; no auth when
# api_keys is empty. Empty disables it.
listen = ""

[log]
# Access log, written by its own thread (never blocks the proxy: when it
# falls behind, lines are dropped and counted as event=dropped).
# off | errors (refusals and failures: 403 policy, wrong key, ban, 4xx/5xx
# from the proxy, truncated responses) | all (+ one line per request / h2
# stream and one per tunnel when it closes).
access = "errors"
# file | stdout. stdout: journald / `docker logs` keep the lines (the
# diagnostics stay on stderr); `file` is then ignored.
output = "file"
# With output = "file": empty = no access log. logrotate: rename, then
# `kill -HUP <pid>` (postrotate), or `copytruncate`.
file = ""
# host (host:port) | url (method + full URL of plain-HTTP requests).
target = "host"

